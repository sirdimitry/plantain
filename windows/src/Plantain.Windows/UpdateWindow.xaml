<Window x:Class="Plantain.Windows.UpdateWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Доступно обновление" Style="{StaticResource {x:Type Window}}" Width="480" SizeToContent="Height" ResizeMode="NoResize"
 ShowInTaskbar="False" ShowActivated="False" WindowStartupLocation="CenterOwner" Icon="Assets/AppIcon.png">
 <StackPanel>
  <Border Background="#BD1A36" Padding="24,21">
   <StackPanel>
    <TextBlock Text="Вышла новая версия" FontSize="20" FontWeight="SemiBold" Foreground="White"/>
    <TextBlock x:Name="NewVersionLabel" FontSize="28" FontWeight="Bold" Foreground="White" Margin="0,5,0,0"/>
   </StackPanel>
  </Border>
  <StackPanel Margin="24">
   <TextBlock x:Name="VersionLabel" Style="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap"/>
   <TextBlock Text="Откроется страница релиза для Windows на GitHub." TextWrapping="Wrap" Margin="0,12,0,0"/>
   <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
    <Button x:Name="LaterButton" Content="Отмена" Click="Later" IsCancel="True" MinWidth="90" Margin="0,0,8,0"/>
    <Button x:Name="DownloadUpdateButton" Content="Скачать" Click="Download" Style="{StaticResource Primary}" IsDefault="True" MinWidth="100"/>
   </StackPanel>
  </StackPanel>
 </StackPanel>
</Window>
