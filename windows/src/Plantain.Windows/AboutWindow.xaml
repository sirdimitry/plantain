<Window x:Class="Plantain.Windows.AboutWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="О Подорожнике" Style="{StaticResource {x:Type Window}}" Width="440" SizeToContent="Height" ResizeMode="NoResize" ShowInTaskbar="False" WindowStartupLocation="CenterOwner">
 <StackPanel Margin="28">
  <Image Source="Assets/AppIcon.png" Width="96" Height="96" Margin="0,0,0,14"/>
  <TextBlock Text="Подорожник" FontSize="26" FontWeight="SemiBold" TextAlignment="Center"/>
  <TextBlock x:Name="VersionText" TextAlignment="Center" Style="{StaticResource Muted}" Margin="0,6,0,16"/>
  <TextBlock Text="Подорожник — скачает, когда Диск не может" TextWrapping="Wrap" TextAlignment="Center"/>
  <TextBlock Text="Ссылки и выбранная папка не запоминаются." TextWrapping="Wrap" TextAlignment="Center" Style="{StaticResource Muted}" Margin="0,10,0,16"/>
  <UniformGrid Columns="2"><Button Content="GitHub автора" Click="GitHub" Margin="0,0,5,0"/><Button Content="X автора" Click="Profile" Margin="5,0,0,0"/></UniformGrid>
  <Button Content="Версия для macOS" Click="MacOS" Margin="0,10,0,16"/>
  <Button Content="Закрыть" Click="Dismiss" IsCancel="True" IsDefault="True" HorizontalAlignment="Center" MinWidth="110"/>
 </StackPanel>
</Window>
